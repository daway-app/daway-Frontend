# ── Daway Pharmacy Web — environment ─────────────────────────────
# Copy this file to `.env.local` and fill in real values.
#
# Vite only exposes variables prefixed with VITE_ to the client bundle.
# Never put a secret here — everything prefixed VITE_ is public.

# Base URL of the Daway Laravel API.
# Local:      http://127.0.0.1:8000
# Production: https://daway-backend-zlh2.onrender.com
VITE_API_BASE_URL=http://127.0.0.1:8000

# Request timeout in milliseconds.
# 60s, not 20s: the API reads from a REMOTE MySQL and reporting endpoints
# measured 17-62s, so a 20s cap made screens fail against their own backend.
VITE_API_TIMEOUT_MS=60000

# Download timeout in milliseconds — for file downloads only (xlsx templates,
# import-error reports, payment receipts). Independent of the request timeout
# above, which covers ordinary JSON calls.
# Default 180s: deliberately longer than VITE_API_TIMEOUT_MS because a file
# transfer is not a JSON round-trip — reusing the 60s request budget would abort
# a legitimate large workbook on a slow connection.
VITE_API_DOWNLOAD_TIMEOUT_MS=180000
