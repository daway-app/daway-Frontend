{
  "routes": [
    {
      "src": "^/assets/[A-Za-z0-9_-]+-[A-Za-z0-9_-]{8}\\.(js|css)$",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "^/(?!assets/).*$",
      "headers": { "Cache-Control": "public, max-age=0, must-revalidate" },
      "continue": true
    },
    { "handle": "filesystem" },
    {
      "src": "^/assets/.*$",
      "status": 404,
      "headers": { "Cache-Control": "no-store" }
    },
    {
      "src": "^/(.*)$",
      "dest": "/index.html",
      "headers": { "Cache-Control": "public, max-age=0, must-revalidate" }
    }
  ]
}
